---
import { Icon } from "astro-icon/components";
import { getLocaleUrl } from "@utils/i18n";
import MainNav from "@components/layout/nav/main-nav.astro";
import LogoWide from '../../icons/biogoship_logo_wide.svg';

interface Props {
  locale: string;
  /** Show a button instead of the site name */
  button?: {
    text: string;
    href: string;
  };
  /** Initial tabIndex for all interactive elements. The scroll header sets -1 and JS updates it. */
  tabIndex?: number;
  /** Set to false to disable the h-24 → h-20 scroll-shrink behaviour (e.g. fixed banner). */
  shrink?: boolean;
  /** Marks the home page to not link the logo */
  isHome?: boolean;
  /** Show a call-to-action button on the right side of the header */
  ctaButton?: {
    text: string;
    href: string;
  };
  /** Show a Github icon and link */
  github?: string;
  /** Force a light or dark version of the logo */
  logoTheme?: 'light' | 'dark';
}

const { locale, button, tabIndex = 0, shrink = true, isHome, ctaButton, github } = Astro.props as Props;
---

<div data-shrink={`${shrink}`} class:list={['mx-6 flex h-24 items-center justify-between gap-10 lg:container lg:mx-auto', shrink && 'header-content-inner transition-[height] duration-300']}>
  {
    button ? (
      <a href={button.href} class="btn-subtle rounded px-3 text-sm" tabindex={tabIndex}>
        <Icon name="heroicons:arrow-left" class="h-4 w-4" />
        {button.text}
      </a>
    ) : isHome ? (
      <span class="flex w-fit shrink-0 items-center" role="img" aria-label="Bio-GO-SHIP">
        <LogoWide class="header-logo h-16 w-auto" aria-hidden="true" />
      </span>
    ) : (
      <a href={getLocaleUrl('/', locale)} class="flex w-fit shrink-0 items-center no-underline select-none hover:no-underline focus:no-underline" tabindex={tabIndex} aria-label="Bio-GO-SHIP">
        <LogoWide class="header-logo h-16 w-auto" aria-hidden="true" />
      </a>
    )
  }
  <div class="flex flex-row-reverse items-center gap-8 lg:flex-row">
    <MainNav {locale} {tabIndex} />
    <div class="flex items-center gap-5">
      {
        ctaButton && (
          <a href={ctaButton.href} class="hover:text-primary hidden text-sm no-underline sm:block" tabindex={tabIndex}>
            {ctaButton.text}
          </a>
        )
      }
      {
        github && (
          <a href={github} target="_blank" rel="noopener" class="hidden lg:block" tabindex={tabIndex}>
            <p class="sr-only hidden" id="GitHubLink">
              GitHub
            </p>
            <Icon aria-labelledby="GitHubLink" name="fa7-brands:github" class="h-6 w-6" />
          </a>
        )
      }
    </div>
  </div>
</div>

<script>
  function updateHeaderShrink() {
    const scrolled = window.scrollY > 60;
    document.querySelectorAll<HTMLElement>('.header-content-inner').forEach((el) => {
      el.classList.toggle('h-24', !scrolled);
      el.classList.toggle('h-20', scrolled);
    });
  }

  function setupHeaderShrink() {
    window.removeEventListener('scroll', updateHeaderShrink);
    window.addEventListener('scroll', updateHeaderShrink, { passive: true });
    updateHeaderShrink();
  }

  const isShrink = document.querySelector<HTMLElement>('.header-content-inner')?.dataset.shrink === 'true';
  if (isShrink) {
    setupHeaderShrink();
    document.addEventListener('astro:page-load', setupHeaderShrink);
  }
</script>

