---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  text: string;
}

const { href, text } = Astro.props;
---

<p class="mb-6">
  <a href={href} class="btn-subtle w-fit rounded px-4 py-2 text-base">
    <Icon name="heroicons:arrow-left" class="h-5 w-5" aria-hidden="true" />
    {text}
  </a>
</p>
