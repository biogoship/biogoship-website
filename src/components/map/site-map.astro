---
export interface MapPoint {
  lat: number;
  lng: number;
  title?: string;
}

export interface MapLine {
  title?: string;
  points: MapPoint[];
}

export interface MapTrack {
  id: string;
  title: string;
  href?: string;
  color: string;
  points?: MapPoint[];
  line?: MapPoint[];
  lines?: MapLine[];
}

interface Props {
  id: string;
  label: string;
  lat?: number;
  lng?: number;
  zoom?: number;
  pin?: boolean;
  pinTitle?: string;
  points?: MapPoint[];
  /** Ordered track points. Drawn as a polyline when there are at least two. */
  line?: MapPoint[];
  /** Extra polylines for a cruise that occupies more than one line. */
  lines?: MapLine[];
  /** Multiple color-coded cruise tracks (overview maps). */
  tracks?: MapTrack[];
  /** Cap for fitBounds. Lower on world overviews so one short track cannot zoom the globe away. */
  fitMaxZoom?: number;
  class?: string;
}

const {
  id,
  label,
  lat = 0,
  lng = 0,
  zoom = 2,
  pin = false,
  pinTitle = "",
  points = [],
  line = [],
  lines = [],
  tracks = [],
  fitMaxZoom = 7,
  class: className = "",
} = Astro.props;
---

<div
  id={id}
  class:list={['site-map overflow-hidden rounded-lg border border-stone-300 bg-stone-100 dark:border-stone-700 dark:bg-stone-800', className || 'mt-4 h-64 w-full sm:h-72']}
  role="img"
  aria-label={label}
  data-site-map
  data-lat={lat}
  data-lng={lng}
  data-zoom={zoom}
  data-fit-max-zoom={fitMaxZoom}
  data-pin={pin ? 'true' : 'false'}
  data-pin-title={pinTitle}
  data-points={JSON.stringify(points)}
  data-line={JSON.stringify(line)}
  data-lines={JSON.stringify(lines)}
  data-tracks={JSON.stringify(tracks)}
></div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Public ArcGIS Online ocean tiles — no API key. Esri uses {z}/{y}/{x}.
  const OCEAN_BASE = 'https://services.arcgisonline.com/arcgis/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}';
  const OCEAN_LABELS = 'https://services.arcgisonline.com/arcgis/rest/services/Ocean/World_Ocean_Reference/MapServer/tile/{z}/{y}/{x}';
  const ATTRIBUTION = 'Tiles &copy; Esri &mdash; Sources: GEBCO, NOAA, CHS, CSUMB, National Geographic, DeLorme, NAVTEQ, and Esri';
  const PIN_BLUE = '#282687';
  const PIN_GREEN = '#a2d12d';
  const LINE_BLUE = PIN_BLUE;
  const TRACK_WEIGHT = 4;
  const TRACK_WEIGHT_ACTIVE = 7;
  const TRACK_OPACITY = 0.95;
  const TRACK_OPACITY_DIMMED = 0.2;

  type Coord = { lat?: unknown; lng?: unknown; title?: string };
  type LineGroup = { title?: string; points: Coord[] };
  type Track = {
    id?: unknown;
    title?: unknown;
    href?: unknown;
    color?: unknown;
    points?: Coord[];
    line?: Coord[];
    lines?: unknown;
  };

  function parseCoordList(raw: string | undefined): Coord[] {
    if (!raw) return [];
    try {
      const parsed: unknown = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function parseTracks(raw: string | undefined): Track[] {
    if (!raw) return [];
    try {
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item): item is Track => typeof item === 'object' && item !== null);
    } catch {
      return [];
    }
  }

  function asLineGroup(item: unknown): LineGroup | null {
    if (!item || typeof item !== "object") return null;
    const record = item as { title?: unknown; points?: unknown };
    if (!Array.isArray(record.points)) return null;
    const title = typeof record.title === "string" && record.title ? record.title : undefined;
    return { title, points: record.points as Coord[] };
  }

  function parseLineGroups(raw: string | undefined): LineGroup[] {
    if (!raw) return [];
    try {
      const parsed: unknown = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.map(asLineGroup).filter((group): group is LineGroup => group !== null);
    } catch {
      return [];
    }
  }

  function trackLineGroups(track: Track): LineGroup[] {
    const groups: LineGroup[] = [];
    if (Array.isArray(track.line) && track.line.length > 1) groups.push({ points: track.line });
    if (Array.isArray(track.lines)) {
      for (const item of track.lines) {
        const group = asLineGroup(item);
        if (group) groups.push(group);
      }
    }
    return groups;
  }

  function asLatLng(point: Coord): [number, number] | null {
    const lat = Number(point.lat);
    const lng = Number(point.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;
    return [lat, lng];
  }

  function unwrapLine(points: Coord[]): L.LatLngExpression[] {
    const lineLatLngs: L.LatLngExpression[] = [];
    for (const point of points) {
      const latlng = asLatLng(point);
      if (!latlng) continue;
      const prev = lineLatLngs.length > 0 ? L.latLng(lineLatLngs[lineLatLngs.length - 1]) : null;
      let pointLng = latlng[1];
      // Keep consecutive points on the short side of the globe so Pacific tracks can cross 180°.
      if (prev) {
        const delta = pointLng - prev.lng;
        if (delta > 180) pointLng -= 360;
        else if (delta < -180) pointLng += 360;
      }
      lineLatLngs.push([latlng[0], pointLng]);
    }
    return lineLatLngs;
  }

  function escapeHtml(value: string) {
    return value.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function popupHtml(title: string, href?: string) {
    const safeTitle = escapeHtml(title);
    if (!href) return `<strong>${safeTitle}</strong>`;
    return `<a href="${escapeHtml(href)}"><strong>${safeTitle}</strong></a>`;
  }

  function pinIcon() {
    return L.divIcon({
      className: 'leaflet-div-icon site-map-pin',
      html: '<svg width="26" height="36" viewBox="0 0 20 28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' + `<path d="M10 1.25C5.3 1.25 1.5 5.05 1.5 9.75c0 6.9 8.5 16.5 8.5 16.5s8.5-9.6 8.5-16.5c0-4.7-3.8-8.5-8.5-8.5z" fill="${PIN_BLUE}" stroke="#fff" stroke-width="1.75"/>` + `<circle cx="10" cy="9.75" r="3.4" fill="${PIN_GREEN}"/>` + '</svg>',
      iconSize: [26, 36],
      iconAnchor: [13, 35],
      popupAnchor: [0, -28],
    });
  }

  function addMarker(map: L.Map, latlng: L.LatLngExpression, title: string) {
    const marker = L.marker(latlng, { icon: pinIcon(), title, keyboard: true, zIndexOffset: 1000 }).addTo(map);
    if (title) marker.bindPopup(`<strong>${escapeHtml(title)}</strong>`);
    return marker;
  }

  function addCircle(map: L.Map, latlng: L.LatLngExpression, color: string, html: string) {
    const marker = L.circleMarker(latlng, {
      radius: 8,
      color: '#fff',
      weight: 2,
      fillColor: color,
      fillOpacity: 1,
    }).addTo(map);
    marker.bindPopup(html);
    return marker;
  }

  function initSiteMaps() {
    document.querySelectorAll<HTMLElement>('[data-site-map]').forEach((el) => {
      if (el.dataset.initialized === 'true') return;
      el.dataset.initialized = 'true';

      const lat = Number(el.dataset.lat);
      const lng = Number(el.dataset.lng);
      const zoom = Number(el.dataset.zoom);
      const fitMaxZoom = Number(el.dataset.fitMaxZoom);
      const pinTitle = el.dataset.pinTitle ?? '';
      const showPin = el.dataset.pin === 'true';
      const points = parseCoordList(el.getAttribute('data-points') ?? el.dataset.points);
      const line = parseCoordList(el.getAttribute('data-line') ?? el.dataset.line);
      const extraLines = parseLineGroups(el.getAttribute('data-lines') ?? el.dataset.lines);
      const tracks = parseTracks(el.getAttribute('data-tracks') ?? el.dataset.tracks);

      const isTouch = window.matchMedia('(pointer: coarse)').matches;

      const map = L.map(el, {
        center: [lat, lng],
        zoom,
        zoomControl: true,
        scrollWheelZoom: false,
        dragging: !isTouch,
        tapHold: false,
        attributionControl: true,
      });

      L.tileLayer(OCEAN_BASE, {
        attribution: ATTRIBUTION,
        maxNativeZoom: 10,
        maxZoom: 16,
      }).addTo(map);
      L.tileLayer(OCEAN_LABELS, {
        maxNativeZoom: 10,
        maxZoom: 16,
      }).addTo(map);

      const bounds: L.LatLngExpression[] = [];
      const lineLatLngsForPins: L.LatLngExpression[] = [];

      if (tracks.length > 0) {
        const layersById = new Map<string, { lines: L.Polyline[]; circles: L.CircleMarker[] }>();

        for (const track of tracks) {
          const color = typeof track.color === 'string' && track.color ? track.color : LINE_BLUE;
          const title = typeof track.title === 'string' ? track.title : '';
          const href = typeof track.href === 'string' ? track.href : undefined;
          const html = popupHtml(title, href);
          const layers: { lines: L.Polyline[]; circles: L.CircleMarker[] } = { lines: [], circles: [] };
          if (typeof track.id === 'string') layersById.set(track.id, layers);

          for (const group of trackLineGroups(track)) {
            const trackLine = unwrapLine(group.points);
            if (trackLine.length < 2) continue;
            const lineHtml = group.title ? popupHtml(group.title, href) : html;
            const polyline = L.polyline(trackLine, {
              color,
              weight: TRACK_WEIGHT,
              opacity: TRACK_OPACITY,
            })
              .bindPopup(lineHtml)
              .addTo(map);
            layers.lines.push(polyline);
            bounds.push(...trackLine);
          }

          for (const point of Array.isArray(track.points) ? track.points : []) {
            const latlng = asLatLng(point);
            if (!latlng) continue;
            layers.circles.push(addCircle(map, latlng, color, html));
            bounds.push(latlng);
          }
        }

        // Legend entries (anywhere on the page) highlight their track on hover/focus.
        const highlight = (activeId: string | null) => {
          for (const [id, { lines: trackLines, circles }] of layersById) {
            const dimmed = activeId !== null && id !== activeId;
            const active = id === activeId;
            for (const trackLine of trackLines) {
              trackLine.setStyle({ weight: active ? TRACK_WEIGHT_ACTIVE : TRACK_WEIGHT, opacity: dimmed ? TRACK_OPACITY_DIMMED : TRACK_OPACITY });
            }
            for (const circle of circles) circle.setStyle({ opacity: dimmed ? TRACK_OPACITY_DIMMED : 1, fillOpacity: dimmed ? TRACK_OPACITY_DIMMED : 1 });
            if (active) {
              for (const trackLine of trackLines) trackLine.bringToFront();
              for (const circle of circles) circle.bringToFront();
            }
          }
        };
        document.querySelectorAll<HTMLElement>(`[data-map-highlight="${el.id}"]`).forEach((trigger) => {
          const trackId = trigger.dataset.trackId ?? null;
          trigger.addEventListener('mouseenter', () => highlight(trackId));
          trigger.addEventListener('focus', () => highlight(trackId));
          trigger.addEventListener('mouseleave', () => highlight(null));
          trigger.addEventListener('blur', () => highlight(null));
        });
      } else {
        if (showPin) {
          addMarker(map, [lat, lng], pinTitle);
          bounds.push([lat, lng]);
        }

        for (const point of points) {
          const latlng = asLatLng(point);
          if (!latlng) continue;
          addMarker(map, latlng, typeof point.title === 'string' ? point.title : '');
          bounds.push(latlng);
        }

        const lineGroups: LineGroup[] = [...extraLines];
        if (line.length > 1) lineGroups.unshift({ points: line });
        for (const group of lineGroups) {
          const lineLatLngs = unwrapLine(group.points);
          if (lineLatLngs.length < 2) continue;
          const polyline = L.polyline(lineLatLngs, {
            color: LINE_BLUE,
            weight: 3,
            opacity: 0.95,
          }).addTo(map);
          if (group.title) polyline.bindPopup(`<strong>${escapeHtml(group.title)}</strong>`);
          bounds.push(...lineLatLngs);
          lineLatLngsForPins.push(...lineLatLngs);
        }
      }

      const maxZoom = Number.isFinite(fitMaxZoom) && fitMaxZoom > 0 ? fitMaxZoom : 7;

      if (bounds.length > 1) {
        map.fitBounds(L.latLngBounds(bounds), { padding: [48, 48], maxZoom });
      } else if (bounds.length === 1) {
        map.setView(bounds[0], Math.max(zoom, 4));
      }

      requestAnimationFrame(() => {
        map.invalidateSize();
        if (lineLatLngsForPins.length > 1) {
          for (const latlng of lineLatLngsForPins) {
            addMarker(map, latlng, '');
          }
        }
      });
    });
  }

  initSiteMaps();
  document.addEventListener('astro:after-swap', () => {
    document.querySelectorAll<HTMLElement>('[data-site-map]').forEach((el) => {
      el.dataset.initialized = 'false';
    });
    initSiteMaps();
  });
</script>

<style>
  /* Contain Leaflet's high z-index panes so they never paint over the header. */
  .site-map {
    position: relative;
    z-index: 0;
    isolation: isolate;
  }

  :global(.site-map-pin) {
    background: transparent !important;
    border: none !important;
  }

  :global(.site-map-pin svg) {
    display: block;
    max-width: none;
  }

  :global(.site-map .leaflet-control-zoom a),
  :global(.site-map .leaflet-bar a) {
    color: #1c1917;
  }
  :global(.dark) .site-map :global(.leaflet-control-zoom a),
  :global(.dark) .site-map :global(.leaflet-bar a) {
    background-color: #292524;
    color: #fafaf9;
    border-color: #44403c;
  }
  :global(.site-map .leaflet-control-attribution) {
    font-size: 10px;
  }
  :global(.dark) .site-map :global(.leaflet-control-attribution) {
    background-color: rgba(41, 37, 36, 0.8);
    color: #d6d3d1;
  }
  :global(.dark) .site-map :global(.leaflet-control-attribution a) {
    color: #a8a29e;
  }
  :global(.site-map .leaflet-popup-content a) {
    color: #282687;
    font-weight: 600;
  }
  :global(.dark) .site-map :global(.leaflet-popup-content a) {
    color: #c4c4ef;
  }
</style>
