---
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { categoryPillStyle, getTaxonomyTitles, resolveTaxonomyTitle, taxonomySlug, withCruiseCategoriesLast } from "@utils/taxonomy";

interface Props {
  entries?: (string | undefined)[];
  locale: string;
  type: "tags" | "categories";
  small?: boolean;
}

const { entries, locale, type, small } = Astro.props as Props;
const t = useTranslations(locale);
const titles = await getTaxonomyTitles();
const titleMap = type === "categories" ? titles.categories : titles.tags;
const categoryColors = titles.categoryColors;

const items = (entries ?? []).filter((entry): entry is string => Boolean(entry));
const orderedItems =
  type === "categories" ? withCruiseCategoriesLast(items, titles.cruiseSlugs, (entry) => entry) : items;

function slugify(value: string) {
  return taxonomySlug(value);
}

function label(value: string) {
  return resolveTaxonomyTitle(value, titleMap, t(`${type}-t.${value}`));
}
---

{
  items.length > 0 ? (
    <ul class:list={['m-0 flex list-none flex-wrap p-0', small ? 'gap-1.5' : 'gap-2']}>
      {orderedItems.map((entry) => (
        <li class="m-0 mt-0">
          <a
            href={getLocaleUrl(`posts/${type}/${slugify(entry)}`, locale)}
            class:list={['inline-flex items-center rounded-full font-semibold no-underline hover:opacity-80', small ? 'px-2.5 py-0.5 text-xs' : 'px-3 py-1 text-sm', type === 'categories' ? undefined : 'bg-surface-muted dark:bg-surface-muted-dark text-stone-700 dark:text-stone-200']}
            style={type === 'categories' ? categoryPillStyle(entry, categoryColors) : undefined}
          >
            {label(entry)}
          </a>
        </li>
      ))}
    </ul>
  ) : small ? null : (
    <p class="text-stone-600 dark:text-stone-300">{t('labels.no-entries')}</p>
  )
}
