---
import { getLocaleUrl, useTranslations } from "@utils/i18n";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import CatTagList from "@components/blog/cat-tag-list.astro";

interface Props {
  entry: CollectionEntry<"articles">;
  locale: string;
  noTransition?: boolean;
}

const { entry, locale, noTransition } = Astro.props as Props;
const t = useTranslations(locale);

const href = getLocaleUrl("posts/" + entry.id.split("/").slice(-1)[0], locale);
const categories = entry.data.categories ?? [];
const tags = entry.data.tags ?? [];
const imageFile = entry.data.image?.file;
const imageUrl = !imageFile && entry.data.image?.url ? entry.data.image.url : undefined;

function previewText(body?: string, excerpt?: string) {
  const source = (body && body.trim()) || excerpt?.trim() || "";
  if (!source) return "";
  return source
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/!\[[^\]]*\]\([^)]+\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/[#>*_`~]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

const preview = previewText(entry.body, entry.data.excerpt);
---

<article>
  <h2 class="m-0 text-lg font-semibold">
    <a href={href} class="text-primary dark:text-primary-light no-underline hover:underline">
      {entry.data.title}
    </a>
  </h2>

  {
    (entry.data.featured || categories.length > 0) && (
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        {entry.data.featured && <span class="text-sm text-stone-500 dark:text-stone-400">{t("labels.featured")}</span>}
        {categories.length > 0 && <CatTagList entries={categories} {locale} type="categories" small />}
      </div>
    )
  }

  <a href={href} class="mt-3 block text-inherit no-underline">
    {preview && <p class="mt-0 mb-0 line-clamp-3 text-sm text-stone-600 dark:text-stone-300">{preview}</p>}
    {
      imageFile ? (
        <Image
          src={imageFile}
          alt={entry.data.image?.alt ?? ""}
          class="mt-3 max-h-40 w-full max-w-md rounded-lg object-cover"
          widths={[400, 640]}
          sizes="(min-width: 768px) 28rem, 100vw"
          transition:name={!noTransition ? "image-" + entry.id : ""}
          draggable="false"
        />
      ) : imageUrl ? (
        <Image
          src={imageUrl}
          alt={entry.data.image?.alt ?? ""}
          class="mt-3 max-h-40 w-full max-w-md rounded-lg object-cover"
          widths={[400, 640]}
          sizes="(min-width: 768px) 28rem, 100vw"
          transition:name={!noTransition ? "image-" + entry.id : ""}
          draggable="false"
          inferSize
        />
      ) : null
    }
  </a>

  {tags.length > 0 && (
    <div class="mt-3">
      <CatTagList entries={tags} {locale} type="tags" small />
    </div>
  )}
</article>
