---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Headline from "@components/headline.astro";
import BackLink from "@components/layout/back-link.astro";
import CatTagList from "@components/blog/cat-tag-list.astro";
import TableOfContents from "@components/blog/table-of-contents.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import { getReadingTime } from "@utils/reading-time";

interface Props {
  entry: CollectionEntry<"articles">;
  prev?: CollectionEntry<"articles">;
  next?: CollectionEntry<"articles">;
  locale: string;
  imageFile?: ImageMetadata;
}

const { entry, locale, prev, next, imageFile } = Astro.props as Props;
const t = useTranslations(locale);

const formattedPublishDate = entry.data.publishDate.toLocaleDateString(locale, { dateStyle: "long" });
const formattedUpdateDate = entry.data.updateDate?.toLocaleDateString(locale, { dateStyle: "long" });
const { Content, headings } = await render(entry);
const tocDepth = entry.data.tocDepth || themeConfig.articles?.tocMaxDepth || 3;
const reducedHeadings = headings.filter(({ depth }: { depth: number }) => depth <= tocDepth);

const authorName = entry.data.author?.name;
const authorUrl = entry.data.author?.url;

function postHref(article: CollectionEntry<"articles">) {
  return getLocaleUrl("posts/" + article.id.split("/").slice(-1)[0], locale);
}

const hideToC = tocDepth === 0 || reducedHeadings.length === 0;
const categories = entry.data.categories ?? [];
const tags = entry.data.tags ?? [];
const localImage = entry.data.image?.file ? imageFile : undefined;
const remoteImage = !entry.data.image?.file && entry.data.image?.url ? entry.data.image.url : undefined;
const readingTime = getReadingTime(entry.body);

const imageSizes = {
  small: { frame: "my-10 max-w-[18rem]", widths: [288, 400], sizes: "18rem" },
  medium: { frame: "my-10 max-w-xl", widths: [400, 640, 768], sizes: "(min-width: 576px) 36rem, 100vw" },
  large: { frame: "my-10 max-w-3xl", widths: [640, 768, 960], sizes: "(min-width: 768px) 48rem, 100vw" },
} as const;
const imageLayout = imageSizes[entry.data.image?.size ?? "large"];
---

<article>
  <header id="start" class="max-w-3xl">
    <BackLink href={getLocaleUrl("posts", locale)} text={t("labels.back-all-articles")} />

    <Headline text={entry.data.title} />

    <p class="m-0 text-base text-stone-500">
      <time datetime={entry.data.publishDate.toISOString()}>{formattedPublishDate}</time>
      {
        formattedUpdateDate && (
          <>
            <span aria-hidden="true"> · </span>
            <span>
              {t("labels.updated")} {formattedUpdateDate}
            </span>
          </>
        )
      }
      {
        readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            <span>
              {readingTime} {t("labels.min-read")}
            </span>
          </>
        )
      }
      {
        authorName && (
          <>
            <span aria-hidden="true"> · </span>
            {authorUrl ? (
              <a href={authorUrl} target="_blank" rel="noopener noreferrer">
                {authorName}
              </a>
            ) : (
              <span>{authorName}</span>
            )}
          </>
        )
      }
    </p>

    {
      (entry.data.featured || categories.length > 0) && (
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
          {entry.data.featured && <span class="text-secondary-dark dark:text-secondary-light text-xs font-semibold tracking-[0.16em] uppercase">{t("labels.featured")}</span>}
          {categories.length > 0 && <CatTagList entries={categories} {locale} type="categories" small />}
        </div>
      )
    }

    {tags.length > 0 && (
      <div class="mt-4">
        <CatTagList entries={tags} {locale} type="tags" small />
      </div>
    )}
  </header>

  {
    localImage ? (
      <figure class={imageLayout.frame}>
        <Image src={localImage} alt={entry.data.image?.alt ?? ""} class="h-auto w-full rounded-lg" widths={[...imageLayout.widths]} sizes={imageLayout.sizes} transition:name={"image-" + entry.id} draggable="false" priority />
      </figure>
    ) : remoteImage ? (
      <figure class={imageLayout.frame}>
        <Image src={remoteImage} alt={entry.data.image?.alt ?? ""} class="h-auto w-full rounded-lg" widths={[...imageLayout.widths]} sizes={imageLayout.sizes} transition:name={"image-" + entry.id} draggable="false" priority inferSize />
      </figure>
    ) : null
  }

  <div class="relative mt-10 flex gap-10 xl:gap-14">
    <div class="markdown-content min-w-0 max-w-3xl grow text-left leading-7">
      {
        !hideToC && (
          <button aria-label={t("labels.toc")} id="open-toc" class="btn-subtle mb-8 rounded px-3 py-1.5 text-sm lg:hidden">
            {t("labels.toc")}
          </button>
        )
      }
      <Content />
    </div>
    {
      !hideToC && (
        <aside class="group/whole-toc sticky top-24 mt-1 mb-5 hidden h-fit w-48 shrink-0 text-left lg:block">
          <TableOfContents headings={reducedHeadings} {locale} />
        </aside>
      )
    }
  </div>
</article>

{
  prev || next ? (
    <nav class="mt-16 max-w-3xl" aria-label={t("labels.pagination")}>
      <div class="flex flex-wrap items-start justify-between gap-6">
        {
          prev ? (
            <a href={postHref(prev)} class="max-w-[45%] font-semibold no-underline hover:underline">
              <span class="block text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">{t("labels.prev")}</span>
              <span class="mt-1 block">{prev.data.title}</span>
            </a>
          ) : (
            <span></span>
          )
        }
        {
          next ? (
            <a href={postHref(next)} class="max-w-[45%] text-right font-semibold no-underline hover:underline">
              <span class="block text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">{t("labels.next")}</span>
              <span class="mt-1 block">{next.data.title}</span>
            </a>
          ) : (
            <span></span>
          )
        }
      </div>
      <BackLink href={getLocaleUrl("posts", locale)} text={t("labels.back-all-articles")} />
    </nav>
  ) : null
}

{
  !hideToC && (
    <div id="toc-overlay" class="text-text dark:text-text-dark bg-background dark:bg-background-dark top-0 left-0 z-50 hidden h-full w-full">
      <button id="close-toc" aria-label={t("labels.close-menu")} class="btn-subtle absolute top-5 right-5 rounded-full">
        <span class="px-2 text-sm">{t("labels.close-menu")}</span>
      </button>
      <div class="h-full w-full overflow-y-auto">
        <div class="container mx-auto flex min-h-full w-full max-w-sm flex-col items-start justify-center py-8">
          <TableOfContents headings={reducedHeadings} {locale} overlay={true} />
        </div>
      </div>
    </div>
  )
}

<script>
  const getFocusable = () => {
    const el = document.getElementById("toc-overlay");
    if (!el) return [];
    return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
  };

  const trapFocus = (event: KeyboardEvent) => {
    const tocOverlay = document.getElementById("toc-overlay");
    if (!tocOverlay || tocOverlay.classList.contains("hidden")) return;
    if (event.key !== "Tab") return;

    const focusable = getFocusable();
    if (!focusable.length) return;

    event.preventDefault();
    const current = document.activeElement;
    const index = focusable.indexOf(current as HTMLElement);
    if (event.shiftKey) {
      const prev = index <= 0 ? focusable.length - 1 : index - 1;
      focusable.at(prev)?.focus();
    } else {
      const next = index === -1 || index === focusable.length - 1 ? 0 : index + 1;
      focusable.at(next)?.focus();
    }
  };

  const openToC = () => {
    const tocOverlay = document.getElementById("toc-overlay");
    if (tocOverlay) {
      tocOverlay.classList.remove("hidden");
      tocOverlay.classList.add("fixed");
      document.body.classList.add("overflow-y-hidden");
      const focusable = getFocusable();
      focusable.at(0)?.focus();
    }
  };

  const closeToC = () => {
    const tocOverlay = document.getElementById("toc-overlay");
    if (!tocOverlay || tocOverlay.classList.contains("hidden")) return;
    tocOverlay.classList.add("hidden");
    tocOverlay.classList.remove("fixed");
    document.body.classList.remove("overflow-y-hidden");
    (document.getElementById("open-toc") as HTMLElement | null)?.focus();
  };

  const handleKeyup = (event: KeyboardEvent) => {
    if (event.key === "Escape") closeToC();
  };

  const setupToC = () => {
    cleanupToC();
    document.getElementById("open-toc")?.addEventListener("click", openToC);
    document.getElementById("close-toc")?.addEventListener("click", closeToC);
    document.addEventListener("keyup", handleKeyup);
    document.addEventListener("keydown", trapFocus);
    document.querySelectorAll(".toc-link").forEach((link) => link.addEventListener("click", closeToC));
  };

  const cleanupToC = () => {
    document.getElementById("open-toc")?.removeEventListener("click", openToC);
    document.getElementById("close-toc")?.removeEventListener("click", closeToC);
    document.removeEventListener("keyup", handleKeyup);
    document.removeEventListener("keydown", trapFocus);
    document.querySelectorAll(".toc-link").forEach((link) => link.removeEventListener("click", closeToC));
  };

  setupToC();
  document.addEventListener("astro:page-load", setupToC);
  document.addEventListener("astro:before-swap", cleanupToC);
</script>
