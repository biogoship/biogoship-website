---
import { cruiseExpeditions, type CruiseExpedition } from "@data/cruise-expeditions";
import { useTranslations } from "@utils/i18n";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

type ColumnId = keyof CruiseExpedition;

interface Column {
  id: ColumnId;
  label: string;
  linkLabel?: string;
}

const columns: Column[] = [
  { id: "expocode", label: "Expocode" },
  { id: "lines", label: "Line(s)" },
  { id: "ship", label: "Ship" },
  { id: "country", label: "Country" },
  { id: "startDate", label: "Start Date" },
  { id: "endDate", label: "End Date" },
  { id: "pi", label: "PI" },
  { id: "cchdo", label: "CCHDO", linkLabel: "CCHDO" },
  { id: "ncei", label: "NCEI", linkLabel: "NCEI" },
  { id: "bcoDmo", label: "BCO-DMO", linkLabel: "BCO-DMO" },
  { id: "seabass", label: "SeaBASS", linkLabel: "SeaBASS" },
  { id: "ncbi", label: "NCBI", linkLabel: "NCBI" },
  { id: "obis", label: "OBIS", linkLabel: "OBIS" },
  { id: "ode", label: "ODE", linkLabel: "ODE" },
];

function cellValue(row: CruiseExpedition, id: ColumnId) {
  return row[id] ?? "";
}
---

<section id="cruise-table-wrap" class="mt-16" aria-labelledby="cruise-data-heading">
  <h2 id="cruise-data-heading" class="font-headline text-primary m-0 text-2xl font-bold tracking-[-0.025em] sm:text-3xl dark:text-white">
    {t("pages.data.table-heading")}
  </h2>
  <div class="bg-accent mt-2 mb-4 h-0.5 w-10" aria-hidden="true"></div>
  <p class="mb-5 max-w-3xl text-sm text-stone-600 dark:text-stone-300">{t("pages.data.table-intro")}</p>

  <fieldset class="m-0 mb-4 border-0 p-0">
    <legend class="mb-2 text-xs font-semibold tracking-[0.14em] text-stone-500 uppercase">{t("pages.data.columns")}</legend>
    <div class="flex flex-wrap gap-x-4 gap-y-2">
      {
        columns.map((column) => (
          <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-stone-700 dark:text-stone-200">
            <input type="checkbox" class="accent-primary h-4 w-4" name="cruise-col" value={column.id} data-col-toggle={column.id} checked />
            {column.label}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="overflow-x-auto">
    <table class="cruise-table w-max min-w-full border-collapse text-left text-sm">
      <caption class="sr-only">{t("pages.data.table-caption")}</caption>
      <thead>
        <tr>
          {
            columns.map((column, index) => (
              <th scope="col" data-col={column.id} class:list={["cruise-th", index === 0 && "cruise-sticky"]}>
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          cruiseExpeditions.map((row) => (
            <tr>
              {columns.map((column, index) => {
                const value = cellValue(row, column.id);
                return (
                  <td data-col={column.id} class:list={["cruise-td", index === 0 && "cruise-sticky"]}>
                    {column.linkLabel && value ? (
                      <a href={value} target="_blank" rel="noopener" class="text-primary dark:text-primary-light font-semibold whitespace-nowrap">
                        {column.linkLabel}
                      </a>
                    ) : value ? (
                      <span class:list={[column.id === "expocode" && "font-mono text-sm"]}>{value}</span>
                    ) : (
                      <span class="text-stone-400" aria-hidden="true">
                        —
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const setupCruiseTable = () => {
    const root = document.getElementById("cruise-table-wrap");
    if (!root || root.dataset.ready === "1") return;
    root.dataset.ready = "1";

    const table = root.querySelector("table");
    if (!table) return;

    const applyColumn = (col: string, show: boolean) => {
      table.querySelectorAll<HTMLElement>(`[data-col="${col}"]`).forEach((cell) => {
        cell.hidden = !show;
      });
    };

    root.querySelectorAll<HTMLInputElement>("[data-col-toggle]").forEach((input) => {
      applyColumn(input.value, input.checked);
      input.addEventListener("change", () => applyColumn(input.value, input.checked));
    });
  };

  setupCruiseTable();
  document.addEventListener("astro:page-load", setupCruiseTable);
</script>

<style>
  @reference "../../styles/tailwind.config.css";

  .cruise-th {
    @apply sticky top-0 z-20 bg-stone-100 px-3 py-2 text-xs font-semibold tracking-[0.08em] whitespace-nowrap text-stone-600 uppercase dark:bg-stone-800 dark:text-stone-300;
  }

  .cruise-td {
    @apply border-t border-stone-200 bg-white px-3 py-2 align-top whitespace-nowrap text-stone-700 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200;
  }

  .cruise-table tbody tr:hover .cruise-td {
    @apply bg-stone-50 dark:bg-stone-800;
  }

  .cruise-sticky {
    @apply sticky left-0 z-10;
  }

  .cruise-th.cruise-sticky {
    @apply z-30;
  }
</style>
