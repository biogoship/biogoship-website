---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { render } from "astro:content";
import "@styles/markdown.css";

interface Props {
  entries: CollectionEntry<"team">[];
  locale: string;
  empty: string;
}

const { entries, empty } = Astro.props;

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);
---

{
  items.length === 0 ? (
    <p class="text-stone-600 dark:text-stone-300">{empty}</p>
  ) : (
    <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2">
      {items.map(({ entry, Content }) => (
        <li class="surface-card m-0 flex items-start gap-5 p-6">
          {entry.data.photo?.file ? (
            <div class="aspect-square w-36 shrink-0 overflow-hidden rounded-lg sm:w-40">
              <Image
                src={entry.data.photo.file}
                alt={entry.data.photo.alt ?? entry.data.name}
                width={800}
                widths={[320, 640, 800]}
                sizes="(min-width: 576px) 160px, 144px"
                class="h-full w-full object-cover object-center"
              />
            </div>
          ) : (
            <span class="bg-primary/10 text-primary dark:bg-primary-darker dark:text-primary-light flex aspect-square w-36 shrink-0 items-center justify-center rounded-lg text-xl font-bold sm:w-40" aria-hidden="true">
              {entry.data.name
                .split(" ")
                .slice(0, 2)
                .map((part) => part[0])
                .join("")}
            </span>
          )}
          <div class="flex min-w-0 flex-col gap-1">
            <h3 class="text-lg font-bold">{entry.data.name}</h3>
            {entry.data.role && <p class="text-primary dark:text-primary-light m-0 text-sm font-semibold">{entry.data.role}</p>}
            {entry.data.affiliation && <p class="m-0 text-sm text-stone-500">{entry.data.affiliation}</p>}
            <div class="markdown-content mt-2 text-sm text-stone-600 dark:text-stone-300">
              <Content />
            </div>
          </div>
        </li>
      ))}
    </ul>
  )
}
