---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import BackLink from "@components/layout/back-link.astro";
import SiteMap from "@components/map/site-map.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import "@styles/markdown.css";

export async function getStaticPaths() {
  const entries = (await getCollection("cruises", ({ data }) => !data.draft)) as CollectionEntry<"cruises">[];
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const entry = (await getEntry("cruises", Astro.params.slug as string)) as CollectionEntry<"cruises"> | undefined;
if (!entry) return Astro.rewrite("/404_dynamic");

const { Content } = await render(entry);
const points = entry.data.map?.points ?? [];
const line = entry.data.map?.line ?? [];
const hasImage = Boolean(entry.data.image?.file);
const hasMap = points.length > 0 || line.length > 1;
---

<Layout title={entry.data.title} description={entry.data.caption} {locale}>
  <article>
    <BackLink href={getLocaleUrl("cruises", locale)} text={t("labels.back-all-cruises")} />
    <Headline text={entry.data.title} />
    {entry.data.date && <p class="m-0 text-base text-stone-500">{entry.data.date.toLocaleDateString(locale, { dateStyle: "long" })}</p>}
    {
      (hasImage || hasMap) && (
        <div class:list={["mt-10 grid gap-8", hasImage && hasMap && "lg:grid-cols-2 lg:items-start"]}>
          {hasImage && entry.data.image?.file && (
            <figure class:list={["m-0", !hasMap && "max-w-xl"]}>
              <Image src={entry.data.image.file} alt={entry.data.image.alt ?? ""} class="aspect-4/3 w-full rounded-xl object-cover" widths={[640, 960]} sizes={hasMap ? "(min-width: 976px) 50vw, 100vw" : "(min-width: 576px) 36rem, 100vw"} />
              {entry.data.caption && <figcaption class="mt-3 text-sm text-stone-600 dark:text-stone-300">{entry.data.caption}</figcaption>}
            </figure>
          )}
          {hasMap && (
            <figure class:list={["m-0", !hasImage && "max-w-xl"]}>
              <div class="aspect-4/3 min-h-56 w-full overflow-hidden rounded-xl">
                <SiteMap id={`cruise-map-${entry.id}`} label={t("pages.cruises.map-label")} points={points} line={line} class="mt-0 h-full w-full" />
              </div>
              <figcaption class="mt-3 text-sm text-stone-600 dark:text-stone-300">
                {t("pages.cruises.map-note")}{" "}
                <a href={getLocaleUrl("data", locale)} class="font-semibold">
                  {t("pages.cruises.map-note-link")}
                </a>
                .
              </figcaption>
            </figure>
          )}
        </div>
      )
    }
    <div class="markdown-content mt-10 max-w-3xl">
      <Content />
    </div>
    <nav class="mt-16 max-w-3xl" aria-label={t("labels.pagination")}>
      <BackLink href={getLocaleUrl("cruises", locale)} text={t("labels.back-all-cruises")} />
    </nav>
  </article>
</Layout>
