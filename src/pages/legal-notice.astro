---
import Layout from "@layouts/default.astro";
import "@styles/long-text-content.css";
import Headline from "@components/headline.astro";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
---

<Layout title={t('pages.legal-notice.title')} robots="noindex, follow">
  <Headline text={t('pages.legal-notice.title')} class="pb-10" />

  <div class="long-text-content">
    <p class="text-stone-500 italic dark:text-stone-300">{t('pages.legal-notice.intro')}</p>
    <p>
      <strong>Bio-GO-SHIP</strong><br />
      University of California, Irvine<br />
      Department of Earth System Science<br />
      Irvine, CA, USA
    </p>
    <p>
      Website: <a href="https://biogoship.org">https://biogoship.org</a><br />
      This site: <a href={themeConfig.site}>{themeConfig.site}</a>
    </p>
    <p>
      For questions about the program or this website, use the <a href={getLocaleUrl('contact', locale)}>Contact</a> page.
    </p>
  </div>
</Layout>
