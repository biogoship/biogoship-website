---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import { Icon } from "astro-icon/components";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from '~/theme.config';

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const githubIssuesUrl = "https://github.com/biogoship/biogoship-website/issues";
const emails = [
  { name: "DEMO — not a real person", address: "not-a-real-person@example.com" },
  { name: "DEMO — fake US inbox", address: "fake-us-team@example.com" },
  { name: "DEMO — fake international inbox", address: "fake-intl-team@example.com" },
];
---

<Layout title={t('pages.contact.title')} description={t('pages.contact.description')}>
  <Headline text={t('pages.contact.title')} class="pb-10" />

  <p class="mb-10 max-w-2xl text-lg text-stone-600 dark:text-stone-300">{t('pages.contact.intro-text')}</p>

  <div class="flex max-w-xl flex-col gap-10">
    <div class="surface-card flex flex-col gap-4 p-5 sm:p-6">
        <h3 class="flex items-center gap-2 text-lg font-semibold">
          <Icon name="fa7-brands:github" class="h-6 w-6" aria-hidden="true" />
          {t('pages.contact.issues-heading')}
        </h3>
        <p class="text-stone-600 dark:text-stone-300">{t('pages.contact.issues-text')}</p>
        <a href={githubIssuesUrl} target="_blank" rel="noopener" class="btn-primary self-start">
          <Icon name="fa7-brands:github" class="h-5 w-5" aria-hidden="true" />
          <span>{t('pages.contact.issues-cta')}</span>
        </a>
    </div>

    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold">{t('pages.contact.email-heading')}</h3>
      <p class="text-stone-600 dark:text-stone-300">{t('pages.contact.email-text')}</p>
      <ul class="m-0 flex list-none flex-col gap-3 p-0">
        {emails.map((person) => (
          <li class="m-0">
            <span class="block text-sm font-semibold">{person.name}</span>
            <a href={`mailto:${person.address}`} class="text-primary dark:text-primary-light">{person.address}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold">{t('pages.contact.docs-heading')}</h3>
      <p>
        {t('pages.contact.docs-text')}<br />
        <a href={getLocaleUrl('faq', locale)} class="flex items-center gap-1 self-start hover:gap-2">
          <span>{t('pages.contact.docs-cta')}</span>
          <Icon name="heroicons:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </a>
      </p>
    </div>
  </div>
</Layout>
