---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import BackLink from "@components/layout/back-link.astro";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import "@styles/markdown.css";

export async function getStaticPaths() {
  const entries = (await getCollection("publications", ({ data }) => !data.draft)) as CollectionEntry<"publications">[];
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const entry = (await getEntry("publications", Astro.params.slug as string)) as CollectionEntry<"publications"> | undefined;
if (!entry) return Astro.rewrite("/404_dynamic");

const { Content } = await render(entry);
const doi = entry.data.doi;
const href = doi ? (doi.startsWith("http") ? doi : `https://doi.org/${doi.replace(/^doi:/i, "")}`) : entry.data.url;
---

<Layout title={entry.data.title} description={entry.data.authors} {locale}>
  <article class="max-w-3xl">
    <BackLink href={getLocaleUrl("publications", locale)} text={t("labels.back-all-publications")} />
    <Headline text={entry.data.title} />
    <p class="m-0 text-base text-stone-500">{entry.data.authors}{entry.data.year ? ` (${entry.data.year})` : ""}</p>
    {entry.data.source && <p class="mt-2 mb-0 text-base text-stone-500 italic">{entry.data.source}</p>}
    {href && (
      <p class="mt-8 mb-0">
        <a href={href} class="text-primary dark:text-primary-light font-semibold" target="_blank" rel="noopener">
          {doi ? `doi:${doi}` : href}
        </a>
      </p>
    )}
    <div class="markdown-content mt-10">
      <Content />
    </div>
  </article>
</Layout>
