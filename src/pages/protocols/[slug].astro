---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import BackLink from "@components/layout/back-link.astro";
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";
import "@styles/markdown.css";

export async function getStaticPaths() {
  const entries = (await getCollection("protocols", ({ data }) => !data.draft)) as CollectionEntry<"protocols">[];
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const entry = (await getEntry("protocols", Astro.params.slug as string)) as CollectionEntry<"protocols"> | undefined;
if (!entry) return Astro.rewrite("/404_dynamic");

const { Content } = await render(entry);

const rawFile = entry.data.file || entry.data.url;
const href = rawFile ? (/^https?:\/\//i.test(rawFile) ? rawFile : `${import.meta.env.BASE_URL.replace(/\/$/, "")}${rawFile.startsWith("/") ? rawFile : `/${rawFile}`}`) : undefined;
---

<Layout title={entry.data.title} description={entry.data.description} {locale}>
  <article class="max-w-3xl">
    <BackLink href={getLocaleUrl("protocols", locale)} text={t("labels.back-all-protocols")} />
    <Headline text={entry.data.title} />
    <p class="m-0 text-base text-stone-500">{entry.data.category}</p>
    {
      href && (
        <p class="mt-8 mb-0">
          <a href={href} class="btn-primary w-fit rounded" target="_blank" rel="noopener">
            <Icon name="heroicons:arrow-down-tray" class="h-5 w-5" aria-hidden="true" />
            {t("pages.protocols.download")}
          </a>
        </p>
      )
    }
    <div class="markdown-content mt-10">
      <Content />
    </div>
  </article>
</Layout>
