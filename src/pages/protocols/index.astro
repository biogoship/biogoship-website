---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import SampleTypesOverview from "@components/protocols/sample-types-overview.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { themeConfig } from "~/theme.config";

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const entries = ((await getCollection("protocols", ({ data }) => !data.draft)) as CollectionEntry<"protocols">[]).sort((a, b) => {
  const category = a.data.category.localeCompare(b.data.category);
  if (category !== 0) return category;
  return a.data.title.localeCompare(b.data.title);
});

function fileHref(entry: CollectionEntry<"protocols">) {
  const raw = entry.data.file || entry.data.url;
  if (!raw) return undefined;
  if (/^https?:\/\//i.test(raw)) return raw;
  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  return `${base}${raw.startsWith("/") ? raw : `/${raw}`}`;
}
---

<Layout title={t('pages.protocols.title')} description={t('pages.protocols.description')} {locale}>
  <Headline text={t('pages.protocols.title')} class="pb-8" />
  <SampleTypesOverview />
  <section class="mt-12 border-t border-stone-200 pt-10 dark:border-stone-700" aria-labelledby="protocols-list-heading">
    <h2 id="protocols-list-heading" class="font-headline text-primary m-0 text-2xl font-bold tracking-[-0.025em] sm:text-3xl dark:text-white">All protocols</h2>
    <div class="bg-accent mt-2 mb-8 h-0.5 w-10" aria-hidden="true"></div>
    {
      entries.length === 0 ? (
        <p class="text-stone-600 dark:text-stone-300">{t('pages.protocols.empty')}</p>
      ) : (
        <ul class="m-0 flex list-none flex-col gap-5 p-0">
          {entries.map((entry) => {
            const href = fileHref(entry);
            const detail = getLocaleUrl(`protocols/${entry.id}`, locale);
            return (
              <li class="surface-card m-0 p-5">
                <p class="text-primary dark:text-primary-light m-0 text-xs font-semibold tracking-[0.16em] uppercase">{entry.data.category}</p>
                <h3 class="mt-2 mb-2 text-lg font-bold text-stone-900 dark:text-white">
                  <a href={detail} class="text-inherit no-underline hover:underline">
                    {entry.data.title}
                  </a>
                </h3>
                <p class="m-0 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{entry.data.description}</p>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  {href && (
                    <a href={href} class="btn-primary rounded" target="_blank" rel="noopener">
                      <Icon name="heroicons:arrow-down-tray" class="h-5 w-5" aria-hidden="true" />
                      {t('pages.protocols.download')}
                    </a>
                  )}
                  <a href={detail} class="text-primary dark:text-primary-light text-sm font-semibold no-underline hover:underline">
                    {t('labels.continue-reading')}
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
</Layout>
