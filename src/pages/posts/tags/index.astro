---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import BackLink from "@components/layout/back-link.astro";
import List from "@components/blog/cat-tag-list.astro";
import { themeConfig } from '~/theme.config';
import { useTranslations, getLocaleUrl } from "@utils/i18n";
import { getCollection } from 'astro:content';
import type { CollectionEntry } from "astro:content";

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);

const allArticles = await getCollection('articles', ({ id, data }) => {
  return !data.draft && id.startsWith(locale + '/');
}) as CollectionEntry<'articles'>[];

const tags = [...new Set(allArticles.map((article) => article.data.tags || []).flat())];
---

<Layout title={t('labels.tags')} {locale}>
  <BackLink href={getLocaleUrl("posts", locale)} text={t("labels.back-all-articles")} />
  <Headline text={t('labels.tags')} class="pb-8" />
  <List entries={tags} {locale} type="tags" />
</Layout>
