---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import List from "@components/blog/list.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';
import { categoryPillStyle, getTaxonomyTitles, sortArticlesByDate, withCruiseCategoriesLast } from "@utils/taxonomy";
import { getCollection } from 'astro:content';
import type { CollectionEntry } from "astro:content";
import type { PaginateFunction } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allArticles = sortArticlesByDate(await getCollection('articles', ({ id, data }) => {
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  }) as CollectionEntry<'articles'>[]);
  return paginate(allArticles, { pageSize: Math.max(allArticles.length, 1) });
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const { page } = Astro.props;

const allArticles = page.data as CollectionEntry<'articles'>[];
const taxonomyTitles = await getTaxonomyTitles();
const categoryPills = withCruiseCategoriesLast(
  [...taxonomyTitles.categories.entries()]
    .map(([slug, title]) => ({ slug, title }))
    .sort((a, b) => a.title.localeCompare(b.title, locale)),
  taxonomyTitles.cruiseSlugs,
  (category) => category.slug,
);
---

<Layout title={t('pages.blog.title')} description={t('pages.blog.description')} {locale}>
  <Headline text={t('pages.blog.title')} class="pb-4" />

  {
    categoryPills.length > 0 && (
      <nav class="mb-10" data-category-filter aria-label={t('labels.categories')}>
        <p class="mt-0 mb-3 text-sm font-semibold text-stone-600 dark:text-stone-300">{t('labels.categories')}</p>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          <li class="m-0 mt-0">
            <button
              type="button"
              data-category=""
              aria-pressed="true"
              class="inline-flex cursor-pointer items-center rounded-full bg-stone-200 px-3 py-1 text-sm font-semibold text-stone-700 no-underline transition-opacity hover:opacity-80 aria-pressed:ring-2 aria-pressed:ring-accent aria-pressed:ring-offset-2 dark:bg-stone-700 dark:text-stone-200 dark:aria-pressed:ring-offset-stone-950"
            >
              {t('labels.all')}
            </button>
          </li>
          {categoryPills.map((category) => (
            <li class="m-0 mt-0">
              <button
                type="button"
                data-category={category.slug}
                aria-pressed="false"
                class="inline-flex cursor-pointer items-center rounded-full px-3 py-1 text-sm font-semibold no-underline transition-opacity hover:opacity-80 aria-pressed:ring-2 aria-pressed:ring-accent aria-pressed:ring-offset-2 dark:aria-pressed:ring-offset-stone-950"
                style={categoryPillStyle(category.slug, taxonomyTitles.categoryColors)}
              >
                {category.title}
              </button>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {allArticles.length > 0 ? <List entries={allArticles} {locale} feed noTransition /> : <p class="text-stone-600 dark:text-stone-300">{t('labels.no-entries')}</p>}
  <p class="text-stone-600 dark:text-stone-300" data-feed-empty hidden>{t('labels.no-entries')}</p>
</Layout>

<script>
  function setupCategoryFilter() {
    const nav = document.querySelector<HTMLElement>('[data-category-filter]');
    const list = document.querySelector<HTMLElement>('[data-post-feed]');
    const empty = document.querySelector<HTMLElement>('[data-feed-empty]');
    if (!nav || !list || nav.dataset.filterReady === 'true') return;
    nav.dataset.filterReady = 'true';

    const buttons = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-category]'));
    const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'));

    const apply = (category: string) => {
      let visible = 0;
      items.forEach((item) => {
        const slugs = (item.dataset.categories || '').split(/\s+/).filter(Boolean);
        const show = !category || slugs.includes(category);
        item.hidden = !show;
        if (show) visible += 1;
      });
      list.hidden = visible === 0;
      if (empty) empty.hidden = visible !== 0;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', (button.dataset.category || '') === category ? 'true' : 'false');
      });
      const url = new URL(window.location.href);
      if (!category) url.searchParams.delete('category');
      else url.searchParams.set('category', category);
      history.replaceState(null, '', url);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => apply(button.dataset.category || ''));
    });

    apply(new URLSearchParams(window.location.search).get('category') || '');
  }

  setupCategoryFilter();
  document.addEventListener('astro:page-load', setupCategoryFilter);
</script>
