---
import Layout from "@layouts/default.astro";
import Headline from "@components/headline.astro";
import List from "@components/blog/list.astro";
import Pagination from "@components/blog/pagination.astro";
import CategoryFilter from "@components/blog/category-filter.astro";
import { useTranslations } from "@utils/i18n";
import { themeConfig } from '~/theme.config';
import { sortArticlesByDate } from "@utils/taxonomy";
import { getCollection } from 'astro:content';
import type { CollectionEntry } from "astro:content";
import type { PaginateFunction } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allArticles = sortArticlesByDate(await getCollection('articles', ({ id, data }) => {
    return !data.draft && id.startsWith(themeConfig.i18n.defaultLocale + '/');
  }) as CollectionEntry<'articles'>[]);
  return paginate(allArticles, { pageSize: themeConfig.articles?.entriesPerPage || 10 });
}

const locale = themeConfig.i18n.defaultLocale;
const t = useTranslations(locale);
const { page } = Astro.props;

const allArticles = page.data as CollectionEntry<'articles'>[];
const numberofPages = Math.ceil(page.total / page.size);
---

<Layout title={t('pages.blog.title') + (page.currentPage > 1 ? ' | ' + t('labels.page') + ' ' + page.currentPage : '')} description={t('pages.blog.description')} {locale}>
  <Headline text={t('pages.blog.title')} class="pb-4" />
  <CategoryFilter {locale} />
  {allArticles.length > 0 ? <List entries={allArticles} {locale} noTransition /> : <p class="text-stone-600 dark:text-stone-300">{t('labels.no-entries')}</p>}
  {numberofPages > 1 && <Pagination {page} {locale} />}
</Layout>

<script>
  // Older links used /posts?category=news. That filter only worked when every
  // post was on one page. Send those links to the category archive instead.
  function redirectCategoryQuery() {
    const category = new URLSearchParams(window.location.search).get('category');
    if (!category) return;
    const path = window.location.pathname.replace(/\/\d+\/?$/, '').replace(/\/$/, '');
    window.location.replace(`${path}/categories/${encodeURIComponent(category)}`);
  }

  redirectCategoryQuery();
  if (document.documentElement.dataset.categoryRedirectReady !== 'true') {
    document.documentElement.dataset.categoryRedirectReady = 'true';
    document.addEventListener('astro:page-load', redirectCategoryQuery);
  }
</script>
