{
  "name": "biogoship-website",
  "version": "1.5.3",
  "stardriveVersion": "1.5.3",
  "private": true,
  "description": "Public website for the Bio-GO-SHIP program",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "postbuild": "node scripts/postbuild.js",
    "check": "npm run check:astro && npm run check:type && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:type": "tsc --noEmit",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "test": "npm run check:astro"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biogoship/biogoship-website.git"
  },
  "keywords": [
    "astro",
    "boilerplate",
    "starter",
    "template",
    "website",
    "static",
    "fast",
    "stable",
    "llm",
    "ai"
  ],
  "author": {
    "name": "Peltmonger Ventures GmbH",
    "url": "https://peltmonger.com/"
  },
  "maintainers": [
    {
      "name": "Jens Kuerschner",
      "url": "https://jekuer.com/"
    }
  ],
  "license": "MIT",
  "funding": "https://github.com/peltmonger/stardrive?sponsor=1",
  "type": "module",
  "bugs": {
    "url": "https://github.com/biogoship/biogoship-website/issues"
  },
  "homepage": "https://biogoship.github.io/biogoship-website",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "leaflet": "^1.9.4",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/ts-plugin": "^1.10.10",
    "@eslint/js": "^10.0.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@types/leaflet": "^1.9.22",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
